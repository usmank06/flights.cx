# Copy to .env. The Next.js app reads everything here, locally and on Vercel.

# --- Flight data and models -------------------------------------------------

# Searches run on the demo market with made-up fares (lib/search/demo.ts) unless a live provider is plugged in
# (lib/flights/provider.ts). Set to "demo" to use the demo market even then.
FLIGHTS_BACKEND=

# OpenRouter key for the planner, the decision model (Jev), the write-up and follow-up answers.
OPENROUTER_API_KEY=sk-or-...

# --- Production ---------------------------------------------------------------
# A production build on Vercel fails without everything in this section (lib/env.ts).

# Postgres. Unset, data is stored as JSON files under .data/, which Vercel doesn't keep.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Set to "file" to use the JSON files even with DATABASE_URL set, e.g. to keep a local dev server off production.
FLIGHTS_STORE=

# Generate each with: openssl rand -hex 32
# AUTH_SECRET signs sessions. CRON_SECRET authenticates Vercel's cron calls to /api/cron/watches.
AUTH_SECRET=
CRON_SECRET=

# Email for sign-in codes and price alerts: Resend, or the webhook below. Without either, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM="Flights <onboarding@resend.dev>"

# Shown on /privacy as the address for questions and data deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Invisible reCAPTCHA on searches, follow-ups and sign-in. Skipped on a dev server unless NEXT_PUBLIC_RECAPTCHA_LOCAL=1.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
NEXT_PUBLIC_RECAPTCHA_LOCAL=

# --- Optional -----------------------------------------------------------------

# Model overrides, by key from lib/search/models.ts. FLIGHTS_MODEL is an older name for FLIGHTS_VOICE_MODEL.
FLIGHTS_VOICE_MODEL=
FLIGHTS_PLANNER_MODEL=
FLIGHTS_EXPLORE_MODEL=

# Required for /api/metrics to respond.
METRICS_TOKEN=

# Gets an hourly email about new errors (each kind at most once a day). Errors are stored in app_errors either way.
ALERT_EMAIL=

# Rate limits per signed-in account, as count/seconds windows, e.g. RATE_SEARCH="30/600,200/86400".
# Also RATE_ASK, RATE_MORE, RATE_GRID, RATE_INTAKE, RATE_WATCH. RATE_INBOX limits sign-in codes per address;
# RATE_ERRORS and RATE_BOOK are shared by everyone. RATE_LIMITS=off disables them all.
RATE_LIMITS=

# Link for the "source" button.
NEXT_PUBLIC_REPO_URL=

# Used for email instead of Resend when RESEND_API_KEY is unset: a JSON POST to any relay.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# The app's public URL when not on Vercel (Vercel sets it automatically).
APP_URL=

# Demo market only: milliseconds per call, to watch a search run. Default 120.
# DEMO_LATENCY_MS=1500
